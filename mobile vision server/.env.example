# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...

# Any current vision-capable Gemini model works. gemini-3.6-flash is a good
# default: fast and cheap enough for single-call, per-image inspection.
GEMINI_MODEL=gemini-3.6-flash

# Optional: comma-separated fallback models, tried in order when the primary
# is busy (HTTP 429/5xx) or not found (404). Leave blank to disable fallback.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Seconds to wait for a single Gemini call before giving up.
GEMINI_TIMEOUT=120

PORT=5000
